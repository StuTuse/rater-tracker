{
  "name": "rater-tracker",
  "version": "1.0.3",
  "description": "离线每日评分与任务成长记录器",
  "author": "TuseCreation",
  "private": true,
  "type": "module",
  "main": "apps/windows/main.cjs",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "dev": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "npm run check && node node_modules/electron-builder/cli.js --win --x64 --dir",
    "dist": "npm run check && node node_modules/electron-builder/cli.js --win nsis --x64 --publish never",
    "dist:signed": "npm run check && node node_modules/electron-builder/cli.js --win nsis --x64 --publish never --config.forceCodeSigning=true",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "start:dev": "node scripts/windows-dev.mjs",
    "android:sync": "node scripts/android-command.mjs sync android",
    "android:build": "node scripts/android-build.mjs",
    "android:verify": "node scripts/android-verify.mjs"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "6.2.4"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "local.ratertracker.desktop",
    "productName": "Rater & Tracker",
    "copyright": "Copyright © 2026 TuseCreation",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "electron/**/*",
      "index.html",
      "VERSION",
      "package.json",
      "packages/**/*",
      "apps/windows/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "artifactName": "Rater-Tracker-${version}-Setup.${ext}"
    }
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
